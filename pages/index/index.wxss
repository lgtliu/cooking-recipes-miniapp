.page {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* ── 顶部 ───────────────────────────────────────── */
.hero {
  padding: 28rpx 32rpx 32rpx;
  border-radius: 0 0 28rpx 28rpx;
  background: linear-gradient(180deg, #fff0e2 0%, #fff8f0 100%);
}

.hero__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.brand__text {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  min-width: 0;
}

.brand__name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.brand__desc {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.3;
}

.user-chip {
  display: flex;
  align-items: center;
  max-width: 240rpx;
  margin-left: 16rpx;
  padding: 5rpx 16rpx 5rpx 5rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--surface);
  flex-shrink: 0;
}

.user-chip:active {
  background: var(--surface-2);
}

.user-chip__avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--surface-2);
  flex-shrink: 0;
}

.user-chip__avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-3);
  font-size: 20rpx;
}

.user-chip__name {
  margin-left: 10rpx;
  max-width: 150rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 21rpx;
  color: var(--ink-3);
}

.mode-tip {
  display: inline-flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--muted);
  font-size: 19rpx;
}

.mode-tip__dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #d9a072;
}

/* ── 搜索 ───────────────────────────────────────── */
.hero__search {
  display: flex;
  align-items: center;
  height: 92rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  background: var(--surface);
  box-shadow: var(--shadow-1);
}

.hero__search-icon {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  margin-right: 18rpx;
  border: 3rpx solid var(--ink-3);
  border-radius: 50%;
  flex-shrink: 0;
}

.hero__search-icon::after {
  content: '';
  position: absolute;
  right: -12rpx;
  bottom: -5rpx;
  width: 16rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--ink-3);
  transform: rotate(45deg);
}

.hero__search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
}

.hero__search-placeholder {
  color: var(--muted);
  font-weight: 400;
}

.hero__search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--ink-3);
  font-size: 28rpx;
  line-height: 1;
  flex-shrink: 0;
}

/* ── 分类 ───────────────────────────────────────── */
.cat-bar {
  width: 100%;
  margin-top: 20rpx;
}

.cat-bar__inner {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 0;
  white-space: nowrap;
}

.cat {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  margin-right: 12rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  color: var(--ink-2);
  font-size: 23rpx;
  white-space: nowrap;
  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
}

.cat:last-child {
  margin-right: 0;
}

.cat:active {
  opacity: 0.7;
}

.cat--active {
  border-color: var(--accent);
  background: var(--accent);
  color: #ffffff;
  font-weight: 600;
}

/* ── 数据条 ─────────────────────────────────────── */
.hero__stats {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx 8rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  background: rgba(255, 255, 255, 0.78);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat__num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent-deep);
  line-height: 1.25;
}

.stat__label {
  margin-top: 2rpx;
  font-size: 19rpx;
  color: var(--muted);
}

.stat__divider {
  width: 1rpx;
  height: 36rpx;
  background: var(--line);
}

/* ── 列表 ───────────────────────────────────────── */
.section {
  padding: 28rpx 28rpx 0;
}

.section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 2rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.section__title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: var(--accent);
  vertical-align: -1rpx;
}

.section__hint {
  font-size: 19rpx;
  color: var(--muted);
}

.feed {
  display: flex;
  align-items: flex-start;
  transition: opacity 140ms ease, transform 140ms ease;
}

/* 分类切换：旧内容轻淡出 → 换数据 → 淡入 */
.feed--switching {
  opacity: 0;
  transform: translateY(8rpx);
}

.feed__col {
  flex: 1;
  min-width: 0;
}

.feed__col + .feed__col {
  margin-left: 16rpx;
}

dish-card {
  display: block;
  animation: fadeUp 240ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

/* ── 首屏加载 / 上拉加载 ──────────────────────────── */
.feed-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0 72rpx;
}

.feed-loading__spinner {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--line);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: feedSpin 720ms linear infinite;
}

@keyframes feedSpin {
  to {
    transform: rotate(360deg);
  }
}

.feed-loading__text {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.feed-foot {
  padding: 36rpx 0 8rpx;
  text-align: center;
}

.feed-foot__text {
  font-size: 22rpx;
  color: var(--muted);
}

.feed-foot__text--end {
  color: #cbbdae;
}

.footer {
  padding: 32rpx 0 12rpx;
  text-align: center;
}

. {
  display: inline-block;
  color: #b7a899;
  font-size: 20rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

/* ── 悬浮按钮 ───────────────────────────────────── */
.fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(156, 63, 28, 0.18);
}

.fab:active {
  background: var(--accent-deep);
}

.fab__plus {
  margin-right: 6rpx;
  font-size: 28rpx;
  line-height: 1;
}

.fab__text {
  font-size: 25rpx;
  font-weight: 600;
}
