.page {
  min-height: 100vh;
  padding: 72rpx 48rpx 60rpx;
  background: linear-gradient(180deg, #ffe9d6 0%, #fff8f0 42%);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #f28a4b 0%, #e0562a 100%);
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 34rpx rgba(224, 86, 42, 0.26);
}

.hero__name {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #3a2a1e;
}

.hero__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a08e7e;
}

.card {
  margin-top: 56rpx;
  padding: 44rpx 36rpx 36rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(120, 80, 50, 0.08);
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: auto;
  margin: 0 auto;
  padding: 0;
  border: none;
  background: transparent;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: #faf0e5;
}

.avatar--empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #e3cdb8;
  background: #fffaf3;
}

.avatar__plus {
  font-size: 44rpx;
  line-height: 1;
  color: #d98a5f;
}

.avatar__tip {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #b08f75;
}

.avatar__badge {
  margin-top: 14rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: #ffe7d8;
  color: #d9713f;
  font-size: 19rpx;
}

.field {
  margin-top: 40rpx;
}

.field__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #7a6454;
}

.field__input {
  width: 100%;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #faf3ea;
  font-size: 28rpx;
  color: #3a2a1e;
}

.ph {
  color: #c3b3a4;
}

.submit {
  width: 100%;
  height: 92rpx;
  margin-top: 40rpx;
  line-height: 92rpx;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f28a4b 0%, #e0562a 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 14rpx 28rpx rgba(224, 86, 42, 0.24);
}

.submit::after {
  border: none;
}

.submit[disabled] {
  background: #e8a98b;
  color: #ffffff;
  box-shadow: none;
}

.privacy {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 20rpx;
  color: #b6a291;
}
