.page {
  min-height: 100vh;
  padding: 64rpx 48rpx 60rpx;
  background: linear-gradient(180deg, #ffefe0 0%, #fff8f0 38%);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
}

.hero__name {
  margin-top: 22rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.hero__desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.card {
  margin-top: 48rpx;
  padding: 36rpx 32rpx 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--shadow-1);
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: auto;
  margin: 0 auto;
  padding: 0;
  border: none;
  background: transparent;
  line-height: normal;
  transition: transform var(--dur-fast) ease, opacity var(--dur-fast) ease;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: var(--surface-2);
}

.avatar--empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #e6d3c1;
  background: #fffaf4;
}

.avatar__plus {
  font-size: 38rpx;
  line-height: 1;
  color: var(--accent);
}

.avatar__tip {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: var(--ink-3);
}

.avatar__badge {
  margin-top: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--accent-wash);
  color: var(--accent-deep);
  font-size: 18rpx;
}

.field {
  margin-top: 36rpx;
}

.field__label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 23rpx;
  font-weight: 500;
  color: var(--ink-2);
}

.field__input {
  width: 100%;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  font-size: 27rpx;
  color: var(--ink);
}

.ph {
  color: #bcaea2;
}

.submit {
  width: 100%;
  height: 88rpx;
  margin-top: 36rpx;
  line-height: 88rpx;
  border: none;
  border-radius: 999rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(156, 63, 28, 0.16);
  transition: transform var(--dur-fast) ease, opacity var(--dur-fast) ease;
}

.submit::after {
  border: none;
}

.submit[disabled] {
  background: #dfa88e;
  color: #ffffff;
  box-shadow: none;
}

.privacy {
  display: block;
  margin-top: 22rpx;
  text-align: center;
  font-size: 19rpx;
  line-height: 1.6;
  color: var(--muted);
}
