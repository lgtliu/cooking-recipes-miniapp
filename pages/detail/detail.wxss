.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ── 头图 ───────────────────────────────────────── */
.hero {
  position: relative;
  height: 560rpx;
  background: #f2e8dd;
  overflow: hidden;
  animation: heroIn 420ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

/* 头图轻推入，避免整屏元素同时弹跳 */
@keyframes heroIn {
  from {
    opacity: 0;
    transform: translateY(14rpx) scale(1.01);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.hero__swiper {
  width: 100%;
  height: 100%;
}

.hero__img {
  width: 100%;
  height: 100%;
}

.hero__img--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7ece1;
}

.hero__emoji {
  font-size: 104rpx;
}

.hero__mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 300rpx;
  background: linear-gradient(180deg, rgba(24, 16, 10, 0) 0%, rgba(24, 16, 10, 0.7) 100%);
  pointer-events: none;
}

.hero__counter {
  position: absolute;
  top: 20rpx;
  right: 28rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(30, 20, 14, 0.32);
  color: rgba(255, 255, 255, 0.94);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.hero__caption {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 44rpx;
  display: flex;
  flex-direction: column;
}

.hero__kicker {
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
}

.hero__name {
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.32);
}

/* ── 内容面板 ───────────────────────────────────── */
.sheet {
  position: relative;
  margin-top: -28rpx;
  padding: 24rpx 28rpx 32rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: var(--bg);
}

.meta-card {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  background: var(--surface);
}

.meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.meta__value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.meta__value--text {
  max-width: 180rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  font-weight: 600;
}

.meta__label {
  margin-top: 2rpx;
  font-size: 19rpx;
  color: var(--muted);
}

.meta__divider {
  width: 1rpx;
  height: 40rpx;
  background: var(--line);
}

.category-row {
  display: flex;
  align-items: center;
  margin: 24rpx 2rpx 0;
}

.category-row__tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 23rpx;
  font-weight: 600;
}

.category-row__hint {
  margin-left: 14rpx;
  font-size: 19rpx;
  color: var(--muted);
}

.intro {
  display: block;
  margin: 24rpx 2rpx 0;
  font-size: 28rpx;
  line-height: 1.9;
  color: var(--ink-2);
}

/* ── 小标题 ─────────────────────────────────────── */
.steps-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 2rpx 20rpx;
}

.steps-head__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.steps-head__title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: var(--accent);
  vertical-align: -1rpx;
}

.steps-head__hint {
  font-size: 19rpx;
  color: var(--muted);
}

/* ── 食材：名称—点线—用量，扫读更省力 ──────────── */
.ingredients {
  margin-top: 4rpx;
}

.ing-list {
  padding: 2rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  background: var(--surface);
}

.ing-item {
  display: flex;
  align-items: baseline;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.ing-item:last-child {
  border-bottom: none;
}

.ing-item__name {
  font-size: 27rpx;
  color: var(--ink-2);
  flex-shrink: 0;
  max-width: 70%;
}

.ing-item__leader {
  flex: 1;
  min-width: 24rpx;
  margin: 0 12rpx;
  border-bottom: 2rpx dotted #ddc9b6;
  transform: translateY(-5rpx);
}

.ing-item__amount {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--accent-deep);
  flex-shrink: 0;
  text-align: right;
}

/* ── 家人分享入口 ───────────────────────────────── */
.family-share {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #f0dccb;
  border-radius: var(--r-sm);
  background: var(--accent-wash);
}

.family-share__body {
  flex: 1;
  min-width: 0;
}

.family-share__title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent-deep);
}

.family-share__desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--ink-3);
}

.family-share__btn {
  margin: 0 0 0 16rpx;
  height: 60rpx;
  padding: 0 28rpx;
  border: none;
  border-radius: 999rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 60rpx;
  flex-shrink: 0;
  transition: transform var(--dur-fast) ease, opacity var(--dur-fast) ease;
}

/* open-type=share 的 button 自带边框，重置掉 */
.family-share__btn::after {
  border: none;
}

/* ── 步骤 ───────────────────────────────────────── */
.step {
  display: flex;
  align-items: stretch;
}

.step__rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 56rpx;
  flex-shrink: 0;
}

.step__no {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border: 1rpx solid #efd8c8;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 21rpx;
  font-weight: 700;
}

.step__line {
  flex: 1;
  width: 2rpx;
  margin-top: 8rpx;
  background: #ead8c7;
}

.step__body {
  flex: 1;
  min-width: 0;
  padding: 2rpx 0 40rpx 16rpx;
}

.step__text {
  display: block;
  font-size: 29rpx;
  line-height: 1.85;
  color: #3d332c;
}

.step__img {
  width: 100%;
  height: 280rpx;
  margin-top: 16rpx;
  border-radius: var(--r-sm);
  background: #f2e8dd;
}

/* ── 页脚操作 ───────────────────────────────────── */
.footer {
  margin-top: 4rpx;
  padding: 36rpx 0 16rpx;
  text-align: center;
}

.footer__slogan {
  display: block;
  font-size: 21rpx;
  color: var(--muted);
}

.footer__btn {
  display: inline-block;
  margin-top: 20rpx;
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
}

.owner-actions {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.owner-btn {
  margin: 0 8rpx;
  padding: 16rpx 40rpx;
  border: 1rpx solid #e2cdbb;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--ink-2);
  font-size: 25rpx;
}

.owner-btn--danger {
  border-color: #eccfc7;
  color: #b34f33;
}

/* ── 找不到 ─────────────────────────────────────── */
.missing {
  padding: 180rpx 56rpx;
  text-align: center;
  animation: pageIn 240ms ease both;
}

.missing__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--accent-wash);
  font-size: 68rpx;
  line-height: 1;
}

.missing__title {
  display: block;
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.missing__desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-3);
}

.missing__reason {
  display: block;
  margin-top: 20rpx;
  padding: 16rpx 22rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--ink-3);
  word-break: break-all;
  text-align: left;
}

.missing__actions {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
}

.missing__btn {
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
}

.missing__btn--ghost {
  margin-right: 16rpx;
  border: 1rpx solid #e2cdbb;
  background: transparent;
  color: var(--ink-2);
}

/* ── 加载中 ─────────────────────────────────────── */
.loading {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
}

.loading__spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--accent-wash);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: loadingSpin 0.8s linear infinite;
}

.loading__text {
  font-size: 24rpx;
  color: var(--ink-3);
}

@keyframes loadingSpin {
  to {
    transform: rotate(360deg);
  }
}
