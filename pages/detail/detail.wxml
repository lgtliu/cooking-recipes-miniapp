<view class="page" wx:if="{{dish}}">
  <view class="hero">
    <swiper
      wx:if="{{dish.images.length > 1}}"
      class="hero__swiper"
      circular
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{dish.images}}" wx:key="*this">
        <image
          class="hero__img"
          src="{{item}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="previewHero"
        />
      </swiper-item>
    </swiper>

    <image
      wx:elif="{{dish.images.length === 1}}"
      class="hero__img"
      src="{{dish.images[0]}}"
      mode="aspectFill"
      data-index="0"
      bindtap="previewHero"
    />

    <view wx:else class="hero__img hero__img--empty">
      <text class="hero__emoji">🍲</text>
    </view>

    <view class="hero__mask"></view>

    <view wx:if="{{dish.images.length > 1}}" class="hero__counter">
      {{current + 1}} / {{dish.images.length}}
    </view>

    <view class="hero__caption">
      <text class="hero__kicker">{{timeText}}更新</text>
      <text class="hero__name">{{dish.name}}</text>
    </view>
  </view>

  <view class="sheet">
    <view class="meta-card reveal" style="animation-delay: 40ms">
      <view class="meta">
        <text class="meta__value">{{dish.steps.length}}</text>
        <text class="meta__label">个步骤</text>
      </view>
      <view class="meta__divider"></view>
      <view class="meta">
        <text class="meta__value">{{dish.images.length}}</text>
        <text class="meta__label">张成品图</text>
      </view>
      <view class="meta__divider"></view>
      <view class="meta">
        <text class="meta__value meta__value--text">{{dish.author}}</text>
        <text class="meta__label">创作者</text>
      </view>
    </view>

    <view class="category-row reveal" style="animation-delay: 90ms" wx:if="{{dish.categoryName}}">
      <text class="category-row__tag">{{dish.categoryIcon}} {{dish.categoryName}}</text>
      <text class="category-row__hint">所属分类</text>
    </view>

    <text class="intro reveal" style="animation-delay: 120ms" wx:if="{{dish.intro}}">{{dish.intro}}</text>

    <view class="ingredients reveal" style="animation-delay: 150ms" wx:if="{{dish.ingredients.length}}">
      <view class="steps-head">
        <text class="steps-head__title">食材</text>
        <text class="steps-head__hint">{{dish.ingredients.length}} 样，提前备好</text>
      </view>
      <view class="ing-list">
        <view class="ing-item" wx:for="{{dish.ingredients}}" wx:key="key">
          <text class="ing-item__name">{{item.name}}</text>
          <view wx:if="{{item.amount}}" class="ing-item__leader"></view>
          <text class="ing-item__amount" wx:if="{{item.amount}}">{{item.amount}}</text>
        </view>
      </view>
    </view>

    <view class="family-share reveal" style="animation-delay: 190ms" wx:if="{{canShare}}">
      <view class="family-share__body">
        <text class="family-share__title">分享给家人</text>
        <text class="family-share__desc">微信转发卡片，家人点开就能看到食材清单</text>
      </view>
      <button class="family-share__btn" open-type="share" hover-class="press-hover">分享</button>
    </view>

    <view class="steps-head reveal" style="animation-delay: 220ms">
      <text class="steps-head__title">做法步骤</text>
      <text class="steps-head__hint">跟着做，不会翻车</text>
    </view>

    <view class="steps">
      <view class="step reveal" style="animation-delay: {{120 + index * 35}}ms" wx:for="{{dish.steps}}" wx:key="no">
        <view class="step__rail">
          <view class="step__no">{{item.no}}</view>
          <view class="step__line" wx:if="{{index !== dish.steps.length - 1}}"></view>
        </view>
        <view class="step__body">
          <text class="step__text">{{item.text}}</text>
          <image
            wx:if="{{item.image}}"
            class="step__img"
            src="{{item.image}}"
            mode="aspectFill"
            data-src="{{item.image}}"
            bindtap="previewStep"
          />
        </view>
      </view>
    </view>

    <view class="footer reveal" style="animation-delay: 300ms" wx:if="{{canManage}}">
      <text class="footer__slogan">这是你记录的菜谱</text>
      <view class="owner-actions">
        <view class="owner-btn press" hover-class="press-hover" bindtap="editDish">编辑菜谱</view>
        <view class="owner-btn owner-btn--danger press" hover-class="press-hover" bindtap="deleteDish">删除</view>
      </view>
    </view>

    <view class="footer reveal" style="animation-delay: 300ms" wx:else>
      <text class="footer__slogan">每一道家常菜，都值得被记录</text>
      <view class="footer__btn press" hover-class="press-hover" bindtap="goCreate">记录我的版本</view>
    </view>
  </view>
</view>

<view class="missing" wx:elif="{{!loading}}">
  <view class="missing__icon">🥣</view>
  <text class="missing__title">这道菜找不到了</text>
  <text class="missing__desc">它可能已经被删除，回首页看看别的菜吧</text>
  <text class="missing__reason" wx:if="{{failReason}}">{{failReason}}</text>
  <view class="missing__actions">
    <view class="missing__btn missing__btn--ghost press" hover-class="press-hover" bindtap="reloadDish">重试</view>
    <view class="missing__btn press" hover-class="press-hover" bindtap="goHome">返回首页</view>
  </view>
</view>

<view class="loading" wx:else>
  <view class="loading__spinner"></view>
  <text class="loading__text">正在端上这道菜…</text>
</view>
