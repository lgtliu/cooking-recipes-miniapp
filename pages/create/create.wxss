.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 240rpx;
}

/* ── 页头 ───────────────────────────────────────── */
.head {
  padding: 8rpx 4rpx 24rpx;
}

.head__title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.35;
}

.head__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-3);
}

/* ── 分组卡片：描边分层，不用重阴影 ────────────── */
.card {
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface);
}

.card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card__heading {
  display: flex;
  align-items: center;
  min-width: 0;
}

.card__index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: var(--accent-wash);
  color: var(--accent-deep);
  font-size: 19rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.card__hint {
  font-size: 19rpx;
  color: var(--muted);
}

.label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.required {
  color: var(--accent);
}

/* ── 文本输入 ───────────────────────────────────── */
.field + .field {
  margin-top: 22rpx;
}

.field__label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink-2);
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  font-size: 28rpx;
  color: var(--ink);
}

.textarea {
  width: 100%;
  min-height: 112rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink);
}

.counter {
  display: block;
  margin-top: 8rpx;
  text-align: right;
  font-size: 19rpx;
  color: var(--muted);
}

.ph {
  color: #bcaea2;
}

/* ── 分类选择 ───────────────────────────────────── */
.cat-picker {
  display: flex;
  flex-wrap: wrap;
}

.cat-opt {
  display: flex;
  align-items: center;
  margin: 0 12rpx 12rpx 0;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--ink-2);
  font-size: 23rpx;
}

.cat-opt:active {
  opacity: 0.75;
}

.cat-opt--active {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-weight: 600;
}

.cat-opt__icon {
  margin-right: 6rpx;
  font-size: 24rpx;
  line-height: 1;
}

.cat-opt__name {
  white-space: nowrap;
}

/* ── 图片网格 ───────────────────────────────────── */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
}

.photo {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: var(--r-sm);
  overflow: hidden;
  background: var(--surface-2);
  animation: popIn 240ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

/* 删除前先收缩淡出，再由 JS 移除节点 */
.photo--out {
  animation: shrinkOut 150ms ease both;
}

.photo:nth-child(3n) {
  margin-right: 0;
}

.photo__img {
  width: 100%;
  height: 100%;
}

.photo__del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(30, 20, 14, 0.45);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
}

.photo__tag {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 34rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 34rpx;
  text-align: center;
}

.photo__cover {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 36rpx;
  background: rgba(30, 20, 14, 0.45);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 36rpx;
  text-align: center;
}

.photo--add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #e6d3c1;
  background: #fffaf4;
}

.photo__plus {
  font-size: 40rpx;
  line-height: 1;
  color: var(--accent);
}

.photo__text {
  margin-top: 8rpx;
  font-size: 19rpx;
  color: var(--ink-3);
}

/* ── 步骤编辑 ───────────────────────────────────── */
.step {
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-sm);
  background: #fdfaf6;
  animation: fadeUp 240ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

.step--out {
  animation: shrinkOut 150ms ease both;
}

.step__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.step__badge {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent-deep);
}

.step__remove {
  padding: 4rpx 8rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.step__input {
  width: 100%;
  min-height: 116rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--line-soft);
  border-radius: 12rpx;
  background: var(--surface);
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink);
}

.step__media {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.thumb {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--surface-2);
  flex-shrink: 0;
}

.thumb__img {
  width: 100%;
  height: 100%;
}

.thumb__del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(30, 20, 14, 0.45);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1;
}

.thumb--add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #e6d3c1;
  background: var(--surface);
}

.thumb__icon {
  font-size: 30rpx;
  line-height: 1;
}

.thumb__text {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: var(--ink-3);
}

.step__tip {
  flex: 1;
  margin-left: 18rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--muted);
}

.add-step {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border: 2rpx dashed #e6d3c1;
  border-radius: var(--r-sm);
  background: #fffaf4;
  color: var(--accent);
  font-size: 25rpx;
  font-weight: 600;
}

/* ── 食材编辑行 ─────────────────────────────────── */
.ing {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.ing__name,
.ing__amount {
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: var(--surface-2);
  font-size: 24rpx;
  color: var(--ink);
}

.ing__name {
  flex: 1;
}

.ing__amount {
  width: 210rpx;
  margin-left: 12rpx;
}

.ing__del {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
}

.ing__add {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  padding: 18rpx 0;
  border: 2rpx dashed #e6d3c1;
  border-radius: 12rpx;
  font-size: 23rpx;
  color: var(--accent);
}

.ing__add-plus {
  margin-right: 6rpx;
  font-size: 26rpx;
  line-height: 1;
}

/* ── 底部发布 ───────────────────────────────────── */
.publish-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 248, 240, 0.96);
}

.publish-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  border-radius: 999rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(156, 63, 28, 0.16);
  transition: transform var(--dur-fast) ease, opacity var(--dur-fast) ease;
}

.publish-btn::after {
  border: none;
}

.publish-btn[disabled] {
  background: #dfa88e;
  color: #ffffff;
  box-shadow: none;
}
