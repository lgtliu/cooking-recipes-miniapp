<view class="page">
  <view class="head">
    <text class="head__title">{{isEdit ? '编辑这道菜' : '记录一道新菜'}}</text>
    <text class="head__desc">{{isEdit ? '修改完成后保存，菜谱详情会同步更新' : '照片和步骤都会保存下来，随时回来看看'}}</text>
  </view>

  <view class="card">
    <view class="card__head">
      <view class="card__heading">
        <text class="card__index">01</text>
        <text class="label">基本信息</text>
      </view>
      <text class="card__hint">先给它起个名字</text>
    </view>

    <view class="field">
      <text class="field__label">菜名 <text class="required">*</text></text>
      <input
        class="input"
        value="{{name}}"
        maxlength="16"
        placeholder="例如：番茄炒蛋"
        placeholder-class="ph"
        bindinput="onNameInput"
      />
    </view>

    <view class="field">
      <text class="field__label">简介</text>
      <textarea
        class="textarea"
        value="{{intro}}"
        maxlength="60"
        placeholder="一句话说说这道菜的味道"
        placeholder-class="ph"
        auto-height
        bindinput="onIntroInput"
      />
      <text class="counter">{{intro.length}}/60</text>
    </view>
  </view>

  <view class="card">
    <view class="card__head">
      <view class="card__heading">
        <text class="card__index">02</text>
        <text class="label">菜谱分类 <text class="required">*</text></text>
      </view>
      <text class="card__hint">选一个最贴近的</text>
    </view>
    <view class="cat-picker">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat-opt {{categoryId === item.id ? 'cat-opt--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >
        <text class="cat-opt__icon">{{item.icon}}</text>
        <text class="cat-opt__name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card__head">
      <view class="card__heading">
        <text class="card__index">03</text>
        <text class="label">食材清单</text>
      </view>
      <text class="card__hint">最多 30 条，可留空</text>
    </view>

    <view class="ing" wx:for="{{ingredients}}" wx:key="key">
      <input
        class="ing__name"
        value="{{item.name}}"
        maxlength="20"
        placeholder="食材名"
        placeholder-class="ph"
        data-index="{{index}}"
        data-field="name"
        bindinput="onIngredientInput"
      />
      <input
        class="ing__amount"
        value="{{item.amount}}"
        maxlength="20"
        placeholder="用量，如 300g"
        placeholder-class="ph"
        data-index="{{index}}"
        data-field="amount"
        bindinput="onIngredientInput"
      />
      <view class="ing__del press" hover-class="press-hover" data-index="{{index}}" catchtap="removeIngredient">×</view>
    </view>

    <view class="ing__add press" hover-class="press-hover" bindtap="addIngredient">
      <text class="ing__add-plus">＋</text>
      <text>添加食材</text>
    </view>
  </view>

  <view class="card">
    <view class="card__head">
      <view class="card__heading">
        <text class="card__index">04</text>
        <text class="label">成品图 <text class="required">*</text></text>
      </view>
      <text class="card__hint">最多 9 张，第一张作封面</text>
    </view>

    <view class="photo-grid">
      <view class="photo {{removing.photo === index ? 'photo--out' : ''}}" wx:for="{{photos}}" wx:key="*this">
        <image
          class="photo__img"
          src="{{item}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="previewPhoto"
        />
        <view class="photo__del press" hover-class="press-hover" data-index="{{index}}" catchtap="removePhoto">×</view>
        <view wx:if="{{index === 0}}" class="photo__tag">封面</view>
        <view wx:else class="photo__cover press" hover-class="press-hover" data-index="{{index}}" catchtap="setCover">设为封面</view>
      </view>

      <view wx:if="{{photos.length < 9}}" class="photo photo--add press" hover-class="press-hover" bindtap="choosePhotos">
        <text class="photo__plus">＋</text>
        <text class="photo__text">上传</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card__head">
      <view class="card__heading">
        <text class="card__index">05</text>
        <text class="label">做法步骤 <text class="required">*</text></text>
      </view>
      <text class="card__hint">写清火候和时间</text>
    </view>

    <view class="step {{removing.step === index ? 'step--out' : ''}}" wx:for="{{steps}}" wx:key="key">
      <view class="step__head">
        <text class="step__badge">第 {{index + 1}} 步</text>
        <text
          wx:if="{{steps.length > 1}}"
          class="step__remove press"
          hover-class="press-hover"
          data-index="{{index}}"
          catchtap="removeStep"
        >删除</text>
      </view>

      <textarea
        class="step__input"
        value="{{item.text}}"
        maxlength="200"
        placeholder="例如：热锅倒油，油温六成热下蛋液，凝固后快速划散"
        placeholder-class="ph"
        auto-height
        data-index="{{index}}"
        bindinput="onStepInput"
      />

      <view class="step__media">
        <view wx:if="{{item.image}}" class="thumb">
          <image
            class="thumb__img"
            src="{{item.image}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindtap="previewStepImage"
          />
          <view class="thumb__del press" data-index="{{index}}" catchtap="removeStepImage">×</view>
        </view>

        <view wx:else class="thumb thumb--add" data-index="{{index}}" bindtap="chooseStepImage">
          <text class="thumb__icon">📷</text>
          <text class="thumb__text">步骤图</text>
        </view>

        <text class="step__tip">选填，有图更直观</text>
      </view>
    </view>

    <view class="add-step press" hover-class="press-hover" bindtap="addStep">＋ 添加步骤</view>
  </view>

  <view class="publish-bar">
    <button class="publish-btn" bindtap="publish" hover-class="press-hover" loading="{{submitting}}" disabled="{{submitting}}">
      {{submitting ? (isEdit ? '保存中…' : '发布中…') : (isEdit ? '保存修改' : '发布菜谱')}}
    </button>
  </view>
</view>
