.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 80rpx;
}

/* ── 个人信息 ───────────────────────────────────── */
.profile {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  background: var(--surface);
}

.profile__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--surface-2);
  flex-shrink: 0;
}

.profile__avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-deep);
  font-size: 34rpx;
  font-weight: 700;
}

.profile__info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.profile__row {
  display: flex;
  align-items: center;
}

.profile__name {
  max-width: 280rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.profile__tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--accent-wash);
  color: var(--accent-deep);
  font-size: 18rpx;
  flex-shrink: 0;
}

.profile__desc {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.profile__action {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* ── 家人入口 ───────────────────────────────────── */
.family-entry {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface);
}

.family-entry:active {
  background: var(--surface-2);
}

.family-entry__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: var(--accent-wash);
  font-size: 32rpx;
  flex-shrink: 0;
}

.family-entry__body {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.family-entry__title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.family-entry__desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.family-entry__arrow {
  margin-left: 10rpx;
  color: #cbb6a3;
  font-size: 30rpx;
  line-height: 1;
}

/* ── 迁移提示 ───────────────────────────────────── */
.migrate {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #f0dccb;
  border-radius: var(--r-md);
  background: var(--accent-wash);
}

.migrate__body {
  flex: 1;
  min-width: 0;
}

.migrate__title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--accent-deep);
}

.migrate__desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--ink-3);
}

.migrate__btn {
  margin-left: 16rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* ── 区块标题 ───────────────────────────────────── */
.section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 2rpx 16rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.section__title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: var(--accent);
  vertical-align: -1rpx;
}

.section__count {
  font-size: 21rpx;
  color: var(--muted);
}

/* ── 菜谱列表 ───────────────────────────────────── */
.list {
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface);
  overflow: hidden;
}

.item {
  display: flex;
  align-items: center;
  padding: 20rpx;
}

.item:active {
  background: var(--surface-2);
}

.item + .item {
  border-top: 1rpx solid var(--line-soft);
}

.item__cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  flex-shrink: 0;
}

.item__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.item__body {
  flex: 1;
  min-width: 0;
  margin: 0 14rpx 0 20rpx;
}

.item__title-row {
  display: flex;
  align-items: center;
}

.item__name {
  max-width: 58%;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item__cat {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--accent-wash);
  color: var(--accent-deep);
  font-size: 17rpx;
  white-space: nowrap;
}

.item__intro {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 19rpx;
  color: var(--muted);
}

.item__arrow {
  color: #cbb6a3;
  font-size: 30rpx;
  line-height: 1;
}

/* ── 加载态 ─────────────────────────────────────── */
.mine-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 56rpx;
}

.mine-loading__spinner {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--line);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: mineSpin 720ms linear infinite;
}

@keyframes mineSpin {
  to {
    transform: rotate(360deg);
  }
}

.mine-loading__text {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

/* ── 底部 ───────────────────────────────────────── */
.logout {
  margin-top: 36rpx;
  height: 84rpx;
  line-height: 84rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: transparent;
  color: var(--ink-3);
  font-size: 25rpx;
  text-align: center;
}

.logout:active {
  background: var(--surface-2);
}

.guest-tip {
  margin-top: 24rpx;
  padding: 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface);
}

.guest-tip__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.guest-tip__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: var(--ink-3);
}
