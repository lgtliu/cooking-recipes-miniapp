.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 80rpx;
}

.loading {
  padding: 140rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: var(--muted);
}

/* ── 状态卡 ─────────────────────────────────────── */
.state-card {
  padding: 56rpx 36rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  background: var(--surface);
  text-align: center;
}

.state-card--compact {
  padding: 32rpx 32rpx;
  text-align: left;
}

.state-card__emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--accent-wash);
  font-size: 56rpx;
  line-height: 1;
}

.state-card__title {
  display: block;
  margin-top: 20rpx;
  font-size: 31rpx;
  font-weight: 700;
  color: var(--ink);
}

.state-card--compact .state-card__title {
  margin-top: 0;
}

.state-card__desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.75;
  color: var(--ink-3);
}

.primary-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 16rpx 46rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
}

/* ── 创建 / 加入 ────────────────────────────────── */
.card {
  margin-top: 20rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface);
}

.card__title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: var(--ink);
}

.card__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ink-3);
}

.join-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.join-input {
  flex: 1;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  font-size: 28rpx;
  letter-spacing: 3rpx;
  color: var(--ink);
}

.join-btn {
  margin-left: 14rpx;
  padding: 0 34rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: var(--r-sm);
  background: var(--accent);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* ── 家庭信息 ───────────────────────────────────── */
.family-card {
  padding: 28rpx;
  border: 1rpx solid #f0dccb;
  border-radius: var(--r-md);
  background: var(--accent-wash);
}

.family-card__top {
  display: flex;
  align-items: center;
}

.family-card__info {
  flex: 1;
  min-width: 0;
}

.family-card__name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.family-card__meta {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.family-card__hint {
  display: block;
  margin-top: 16rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #a8552f;
}

.share-btn {
  margin: 0;
  padding: 0 26rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
  transition: transform var(--dur-fast) ease, opacity var(--dur-fast) ease;
}

.share-btn::after {
  border: none;
}

.invite-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #f0dccb;
  border-radius: var(--r-sm);
  background: var(--surface);
}

.invite-row__label {
  font-size: 21rpx;
  color: var(--ink-3);
}

.invite-row__code {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--accent-deep);
}

.invite-row__copy {
  padding: 6rpx 20rpx;
  border: 1rpx solid #dfc3ad;
  border-radius: 999rpx;
  color: var(--accent-deep);
  font-size: 21rpx;
}

.invite-row__copy:active {
  background: var(--accent-wash);
}

/* ── 区块标题 ───────────────────────────────────── */
.section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 2rpx 16rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.section__title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: var(--accent);
  vertical-align: -1rpx;
}

.section__count {
  font-size: 21rpx;
  color: var(--muted);
}

/* ── 成员 ───────────────────────────────────────── */
.members {
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface);
  overflow: hidden;
}

.member {
  display: flex;
  align-items: center;
  padding: 20rpx;
}

.member + .member {
  border-top: 1rpx solid var(--line-soft);
}

.member__avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--surface-2);
  flex-shrink: 0;
}

.member__avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-wash);
  color: var(--accent-deep);
  font-size: 27rpx;
  font-weight: 700;
}

.member__body {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.member__row {
  display: flex;
  align-items: center;
}

.member__name {
  max-width: 260rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.member__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
}

.member__sub--on {
  color: var(--success);
}

.member__sub--off {
  color: #b06a4a;
}

.tag {
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 17rpx;
  white-space: nowrap;
}

.tag--self {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

.tag--owner {
  background: #fbf1d9;
  color: #9a6f1c;
}

.member__act {
  padding: 10rpx 22rpx;
  border: 1rpx solid #e0c3ac;
  border-radius: 999rpx;
  color: var(--accent-deep);
  font-size: 21rpx;
  flex-shrink: 0;
}

.member__act:active {
  background: var(--accent-wash);
}

.member__act--danger {
  border-color: #eccfc7;
  color: #b34f33;
}

/* ── 说明 ───────────────────────────────────────── */
.notice {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface-2);
}

.notice__title {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.notice__text {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.75;
  color: var(--ink-3);
}

.leave-btn {
  margin-top: 36rpx;
  height: 84rpx;
  line-height: 84rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--ink-3);
  font-size: 25rpx;
  text-align: center;
}

.leave-btn:active {
  background: var(--surface-2);
}

.owner-note {
  display: block;
  margin-top: 28rpx;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--muted);
}
