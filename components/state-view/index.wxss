/* 状态视图：加载失败 / 空列表 / 无结果共用，样式自带不依赖页面类名 */
.state {
  padding: 64rpx 40rpx 56rpx;
  border: 1rpx solid #efe3d7;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  animation: stateIn 240ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes stateIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.state__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #fdf4ee;
  font-size: 60rpx;
  line-height: 1;
}

.state__title {
  display: block;
  margin-top: 22rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #2e2621;
}

.state__desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #8b7c71;
  word-break: break-all;
}

.state__btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 18rpx 44rpx;
  border-radius: 999rpx;
  background: #c4562c;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  transition: transform 120ms ease, opacity 120ms ease;
}

.state__btn--hover {
  transform: scale(0.96);
  opacity: 0.9;
}
