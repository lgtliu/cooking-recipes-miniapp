:host {
  display: block;
}

.card {
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(74, 52, 38, 0.05);
  transition: transform 0.16s ease;
}

.card--hover {
  transform: scale(0.985);
}

.media {
  position: relative;
  width: 100%;
  background: #f3e9df;
  overflow: hidden;
}

.cover {
  width: 100%;
  height: 100%;
}

.cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7ede2;
}

.empty-emoji {
  font-size: 64rpx;
}

.shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 170rpx;
  background: linear-gradient(180deg, rgba(30, 20, 14, 0) 0%, rgba(30, 20, 14, 0.58) 100%);
}

.cat-tag {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  max-width: 192rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #8a4a24;
  font-size: 19rpx;
  font-weight: 600;
}

.badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(30, 20, 14, 0.42);
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 500;
}

.title-wrap {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 16rpx;
}

.name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.32);
}

.body {
  padding: 16rpx 18rpx 18rpx;
}

.intro {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 22rpx;
  line-height: 1.55;
  color: #8b7c71;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 19rpx;
  color: #a99a8d;
}

.author {
  max-width: 132rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dot {
  margin: 0 8rpx;
}
