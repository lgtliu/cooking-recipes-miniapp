[{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"青椒肉丝","intro":"经典快手小炒，肉丝滑嫩、青椒爽脆，最下饭的家常味道。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/qingjiao-rousi.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/qingjiao-rousi.jpg"],"ingredients":[{"name":"猪里脊","amount":"250g"},{"name":"青椒","amount":"3 个"},{"name":"大蒜","amount":"3 瓣"},{"name":"生抽","amount":"1 勺"},{"name":"料酒","amount":"1 勺"},{"name":"淀粉","amount":"半勺"},{"name":"盐","amount":"适量"}],"steps":[{"text":"里脊肉切细丝，加料酒、生抽、淀粉抓匀，腌 10 分钟。","image":""},{"text":"青椒去蒂去籽切丝，蒜切片备用。","image":""},{"text":"热锅倒油，下肉丝滑炒至变色盛出。","image":""},{"text":"锅内留底油，爆香蒜片，下青椒丝大火炒至断生。","image":""},{"text":"倒回肉丝，加盐调味，翻炒均匀即可出锅。","image":""}],"categoryId":"home","createdAt":1794000000000,"updatedAt":1794000000000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"鱼香茄子","intro":"咸甜酸辣兼备的川味经典，茄子软糯入味，酱汁浓郁下饭。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/yuxiang-qiezi.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/yuxiang-qiezi.jpg"],"ingredients":[{"name":"长茄子","amount":"2 根"},{"name":"猪肉末","amount":"100g"},{"name":"郫县豆瓣酱","amount":"1 勺"},{"name":"蒜末","amount":"3 瓣"},{"name":"葱花","amount":"适量"},{"name":"生抽","amount":"2 勺"},{"name":"香醋","amount":"1 勺"},{"name":"白糖","amount":"1 勺"},{"name":"淀粉","amount":"半勺"}],"steps":[{"text":"茄子切滚刀块，撒盐腌 10 分钟后挤干水分。","image":""},{"text":"用生抽、香醋、白糖、淀粉和半碗水调成鱼香汁。","image":""},{"text":"热锅多放些油，把茄子煎软盛出。","image":""},{"text":"下肉末炒散，加豆瓣酱、蒜末炒出红油。","image":""},{"text":"倒回茄子，淋入鱼香汁，大火收汁撒葱花即可。","image":""}],"categoryId":"home","createdAt":1793996400000,"updatedAt":1793996400000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"麻婆豆腐","intro":"川菜代表，麻辣鲜香烫，豆腐嫩滑不碎，配米饭一绝。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/mapo-doufu.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/mapo-doufu.jpg"],"ingredients":[{"name":"嫩豆腐","amount":"1 盒"},{"name":"猪肉末","amount":"80g"},{"name":"郫县豆瓣酱","amount":"1 勺"},{"name":"豆豉","amount":"半勺"},{"name":"花椒粉","amount":"适量"},{"name":"蒜末","amount":"3 瓣"},{"name":"水淀粉","amount":"适量"},{"name":"小葱","amount":"2 根"}],"steps":[{"text":"豆腐切 2 厘米方块，放入加盐的开水中焯烫 1 分钟捞出。","image":""},{"text":"热锅倒油，下肉末炒散至微焦，加豆瓣酱、豆豉、蒜末炒出红油。","image":""},{"text":"加半碗热水煮开，轻轻放入豆腐，中火烧 3 分钟。","image":""},{"text":"分两次淋入水淀粉勾芡，轻轻推匀。","image":""},{"text":"出锅撒花椒粉和葱花即可。","image":""}],"categoryId":"home","createdAt":1793992800000,"updatedAt":1793992800000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"宫保鸡丁","intro":"糊辣荔枝味的经典川菜，鸡丁滑嫩、花生酥脆，酸甜微辣。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/gongbao-jiding.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/gongbao-jiding.jpg"],"ingredients":[{"name":"鸡胸肉","amount":"300g"},{"name":"熟花生米","amount":"50g"},{"name":"干辣椒","amount":"8 个"},{"name":"花椒","amount":"1 小把"},{"name":"大葱","amount":"1 段"},{"name":"生抽","amount":"2 勺"},{"name":"香醋","amount":"1 勺"},{"name":"白糖","amount":"1 勺"},{"name":"淀粉","amount":"半勺"}],"steps":[{"text":"鸡胸肉切丁，加生抽、淀粉抓匀腌 15 分钟。","image":""},{"text":"用生抽、香醋、白糖、淀粉加 2 勺水调成宫保汁。","image":""},{"text":"热锅倒油，下干辣椒、花椒小火煸香，再下葱段。","image":""},{"text":"倒入鸡丁大火滑炒至变色。","image":""},{"text":"淋入宫保汁翻炒收浓，最后加花生米翻匀出锅。","image":""}],"categoryId":"home","createdAt":1793989200000,"updatedAt":1793989200000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"回锅肉","intro":"川菜之首，肥而不腻的五花肉配蒜苗，咸香微辣有嚼劲。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/huiguo-rou.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/huiguo-rou.jpg"],"ingredients":[{"name":"带皮五花肉","amount":"400g"},{"name":"蒜苗","amount":"3 根"},{"name":"郫县豆瓣酱","amount":"1 勺"},{"name":"豆豉","amount":"半勺"},{"name":"甜面酱","amount":"半勺"},{"name":"姜片","amount":"3 片"},{"name":"料酒","amount":"1 勺"}],"steps":[{"text":"五花肉整块冷水下锅，加姜片、料酒煮 20 分钟至八成熟，捞出晾凉切薄片。","image":""},{"text":"蒜苗斜切段，蒜白和蒜叶分开。","image":""},{"text":"热锅少油，下肉片中小火煸炒至出油卷曲呈灯盏窝。","image":""},{"text":"把肉推到锅边，下豆瓣酱、豆豉、甜面酱炒出红油，与肉翻炒均匀。","image":""},{"text":"先下蒜白炒几下，再下蒜叶炒至断生即可出锅。","image":""}],"categoryId":"home","createdAt":1793985600000,"updatedAt":1793985600000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"酸辣土豆丝","intro":"酸爽开胃的国民小炒，土豆丝脆嫩爽口，成本低又快手。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/suanla-tudousi.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/suanla-tudousi.jpg"],"ingredients":[{"name":"土豆","amount":"2 个"},{"name":"干辣椒","amount":"4 个"},{"name":"花椒","amount":"10 粒"},{"name":"白醋","amount":"2 勺"},{"name":"大蒜","amount":"2 瓣"},{"name":"盐","amount":"适量"},{"name":"青椒","amount":"1 个"}],"steps":[{"text":"土豆去皮切细丝，放清水里冲洗 2 遍去掉淀粉，泡水备用。","image":""},{"text":"青椒切丝，干辣椒剪段，蒜切片。","image":""},{"text":"热锅倒油，小火煸香花椒后捞出，下干辣椒、蒜片爆香。","image":""},{"text":"土豆丝沥干下锅，大火快炒 1 分钟，加青椒丝续炒。","image":""},{"text":"沿锅边淋入白醋，加盐调味，再炒半分钟立即出锅。","image":""}],"categoryId":"home","createdAt":1793982000000,"updatedAt":1793982000000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"地三鲜","intro":"东北经典素菜，土豆、茄子、青椒三种时蔬过油烧制，浓香下饭。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/di-san-xian.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/di-san-xian.jpg"],"ingredients":[{"name":"土豆","amount":"1 个"},{"name":"茄子","amount":"1 根"},{"name":"青椒","amount":"2 个"},{"name":"大蒜","amount":"3 瓣"},{"name":"生抽","amount":"2 勺"},{"name":"蚝油","amount":"1 勺"},{"name":"白糖","amount":"半勺"},{"name":"淀粉","amount":"半勺"}],"steps":[{"text":"土豆、茄子切滚刀块，青椒手撕成片。","image":""},{"text":"用生抽、蚝油、白糖、淀粉和半碗水调成料汁。","image":""},{"text":"油温六成热，先炸土豆块至金黄捞出，再炸茄子至软身捞出。","image":""},{"text":"锅留底油，爆香蒜末，下青椒略炒。","image":""},{"text":"倒回土豆和茄子，淋入料汁大火翻匀收汁即可。","image":""}],"categoryId":"home","createdAt":1793978400000,"updatedAt":1793978400000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"木须肉","intro":"鲁味传统合菜，肉片、鸡蛋、木耳、黄花菜一锅出，荤素平衡。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/muxu-rou.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/muxu-rou.jpg"],"ingredients":[{"name":"猪里脊","amount":"150g"},{"name":"鸡蛋","amount":"3 个"},{"name":"干木耳","amount":"1 小把"},{"name":"干黄花菜","amount":"1 小把"},{"name":"黄瓜","amount":"半根"},{"name":"生抽","amount":"1 勺"},{"name":"料酒","amount":"1 勺"},{"name":"盐","amount":"适量"}],"steps":[{"text":"木耳、黄花菜提前泡发洗净；里脊切片，用料酒、生抽、少许淀粉腌 10 分钟。","image":""},{"text":"鸡蛋打散炒熟盛出。","image":""},{"text":"热锅倒油下肉片滑炒至变色。","image":""},{"text":"下木耳、黄花菜翻炒 1 分钟，再加黄瓜片。","image":""},{"text":"倒回鸡蛋，加盐调味，大火翻匀出锅。","image":""}],"categoryId":"home","createdAt":1793974800000,"updatedAt":1793974800000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"干煸四季豆","intro":"干香入味的川式做法，四季豆煸出虎皮，肉末提香，越嚼越香。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/ganbian-sijidou.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/ganbian-sijidou.jpg"],"ingredients":[{"name":"四季豆","amount":"400g"},{"name":"猪肉末","amount":"80g"},{"name":"干辣椒","amount":"6 个"},{"name":"花椒","amount":"1 小把"},{"name":"蒜末","amount":"3 瓣"},{"name":"生抽","amount":"1 勺"},{"name":"盐","amount":"适量"}],"steps":[{"text":"四季豆撕去老筋，掰成段并彻底晾干水分。","image":""},{"text":"锅中多放油，中火把四季豆煸至表皮起皱起虎皮，盛出备用。","image":""},{"text":"锅留底油，下肉末炒散至焦香，加干辣椒、花椒、蒜末炒香。","image":""},{"text":"倒回四季豆，加生抽、盐，大火翻炒均匀即可。","image":""}],"categoryId":"home","createdAt":1793971200000,"updatedAt":1793971200000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"糖醋排骨","intro":"酸甜适口的江浙名菜，色泽红亮，外焦里嫩，大人孩子都爱。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/tangcu-paigu.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/tangcu-paigu.jpg"],"ingredients":[{"name":"猪肋排","amount":"500g"},{"name":"冰糖","amount":"30g"},{"name":"香醋","amount":"3 勺"},{"name":"生抽","amount":"2 勺"},{"name":"料酒","amount":"2 勺"},{"name":"姜片","amount":"3 片"},{"name":"熟白芝麻","amount":"适量"}],"steps":[{"text":"排骨冷水下锅，加料酒、姜片焯水，捞出洗净沥干。","image":""},{"text":"热锅少油，下冰糖小火炒至融化呈琥珀色。","image":""},{"text":"下排骨翻炒上色，加生抽、2 勺香醋和热水没过排骨。","image":""},{"text":"大火烧开后转小火焖 30 分钟，收汁前再淋 1 勺香醋提香。","image":""},{"text":"大火收浓汤汁，撒白芝麻出锅。","image":""}],"categoryId":"meat","createdAt":1793967600000,"updatedAt":1793967600000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"可乐鸡翅","intro":"零失败的新手硬菜，可乐的甜香裹着焦糖色鸡翅，软嫩多汁。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/kele-jichi.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/kele-jichi.jpg"],"ingredients":[{"name":"鸡翅中","amount":"8 个"},{"name":"可乐","amount":"1 罐"},{"name":"生抽","amount":"2 勺"},{"name":"老抽","amount":"半勺"},{"name":"料酒","amount":"1 勺"},{"name":"姜片","amount":"3 片"}],"steps":[{"text":"鸡翅两面各划两刀，冷水下锅加料酒、姜片焯水，捞出擦干。","image":""},{"text":"平底锅少油，把鸡翅煎至两面金黄。","image":""},{"text":"倒入整罐可乐，加生抽、老抽，大火烧开。","image":""},{"text":"转中火盖盖焖 15 分钟，再开大火收汁至浓稠挂勺即可。","image":""}],"categoryId":"meat","createdAt":1793964000000,"updatedAt":1793964000000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"红烧狮子头","intro":"淮扬经典大肉圆，肥瘦相间、软糯鲜香，入口即化。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/hongshao-shizitou.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/hongshao-shizitou.jpg"],"ingredients":[{"name":"猪前腿肉","amount":"500g"},{"name":"马蹄","amount":"6 颗"},{"name":"鸡蛋","amount":"1 个"},{"name":"姜葱水","amount":"3 勺"},{"name":"生抽","amount":"2 勺"},{"name":"老抽","amount":"半勺"},{"name":"蚝油","amount":"1 勺"},{"name":"淀粉","amount":"1 勺"},{"name":"上海青","amount":"6 棵"}],"steps":[{"text":"猪肉手工剁成粗粒，马蹄切碎，一起加鸡蛋、盐、姜葱水、淀粉，顺一个方向搅打上劲。","image":""},{"text":"团成四个大丸子，双手来回摔打至紧实。","image":""},{"text":"油温六成热，丸子炸至表面定型金黄捞出。","image":""},{"text":"砂锅加生抽、老抽、蚝油和热水，放入丸子小火炖 40 分钟。","image":""},{"text":"上海青烫熟围边，狮子头装盘浇汁即可。","image":""}],"categoryId":"meat","createdAt":1793960400000,"updatedAt":1793960400000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"卤牛肉","intro":"一次卤一大块，切片即食，酱香浓郁，凉热都好吃。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/lu-niurou.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/lu-niurou.jpg"],"ingredients":[{"name":"牛腱子","amount":"1000g"},{"name":"八角","amount":"2 颗"},{"name":"桂皮","amount":"1 段"},{"name":"香叶","amount":"3 片"},{"name":"生抽","amount":"4 勺"},{"name":"老抽","amount":"2 勺"},{"name":"冰糖","amount":"20g"},{"name":"姜","amount":"1 块"},{"name":"料酒","amount":"2 勺"}],"steps":[{"text":"牛腱子冷水浸泡 1 小时去血水，冷水下锅加料酒焯水，捞出洗净。","image":""},{"text":"锅中加水、所有香料和调料，放入牛腱子大火烧开。","image":""},{"text":"转小火盖盖卤 1.5 小时，用筷子能轻松扎透即可。","image":""},{"text":"关火后让牛肉在卤汤里浸泡 2 小时以上更入味。","image":""},{"text":"捞出晾凉，逆着纹理切薄片装盘，可调一份蒜泥醋汁蘸食。","image":""}],"categoryId":"meat","createdAt":1793956800000,"updatedAt":1793956800000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"白切鸡","intro":"粤式经典，皮爽肉滑、原汁原味，配姜葱蘸料才够地道。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/baiqie-ji.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/baiqie-ji.jpg"],"ingredients":[{"name":"三黄鸡","amount":"1 只（约 1.2kg）"},{"name":"生姜","amount":"1 大块"},{"name":"小葱","amount":"5 根"},{"name":"料酒","amount":"2 勺"},{"name":"花生油","amount":"2 勺"},{"name":"盐","amount":"适量"}],"steps":[{"text":"整鸡洗净沥干。大锅烧开足量水，加姜片、葱结、料酒。","image":""},{"text":"提着鸡脖子把鸡放入沸水中烫 5 秒提起，重复 3 次，让鸡腔内外温度一致。","image":""},{"text":"整鸡入锅，水微沸状态浸煮 25 分钟，中途翻面一次。","image":""},{"text":"捞出立刻放入冰水中浸 10 分钟，让鸡皮收紧爽滑。","image":""},{"text":"姜葱切末，浇上烧热的花生油加盐做成蘸料，鸡斩件装盘蘸食。","image":""}],"categoryId":"meat","createdAt":1793953200000,"updatedAt":1793953200000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"蜜汁叉烧","intro":"广式烧味代表，红亮油润、甜咸交织，边缘带一点焦香。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/mizhi-chashao.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/mizhi-chashao.jpg"],"ingredients":[{"name":"梅头肉","amount":"600g"},{"name":"叉烧酱","amount":"3 勺"},{"name":"蜂蜜","amount":"2 勺"},{"name":"生抽","amount":"1 勺"},{"name":"料酒","amount":"1 勺"},{"name":"蒜末","amount":"3 瓣"},{"name":"红腐乳","amount":"1 块"}],"steps":[{"text":"梅头肉切成长条，用叉烧酱、生抽、料酒、蒜末、红腐乳抓匀，冷藏腌制过夜。","image":""},{"text":"烤箱预热 200 度，烤网上放肉条，下层垫接油盘。","image":""},{"text":"烤 20 分钟后取出，两面刷蜂蜜和剩余腌汁。","image":""},{"text":"继续烤 15~20 分钟，至边缘微焦、表面红亮。","image":""},{"text":"出炉静置 5 分钟再切片，淋少许烤盘里的酱汁。","image":""}],"categoryId":"meat","createdAt":1793949600000,"updatedAt":1793949600000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"梅菜扣肉","intro":"客家名菜，五花肉蒸得酥烂，梅干菜吸饱油脂咸香下饭。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/meicai-kourou.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/meicai-kourou.jpg"],"ingredients":[{"name":"带皮五花肉","amount":"500g"},{"name":"梅干菜","amount":"150g"},{"name":"生抽","amount":"2 勺"},{"name":"老抽","amount":"1 勺"},{"name":"蚝油","amount":"1 勺"},{"name":"白糖","amount":"1 勺"},{"name":"姜片","amount":"3 片"},{"name":"八角","amount":"1 颗"}],"steps":[{"text":"五花肉整块冷水下锅煮 25 分钟捞出，趁热在皮上抹老抽上色。","image":""},{"text":"热锅把肉皮朝下煎至金黄起泡，捞出切片。","image":""},{"text":"梅干菜泡发洗净挤干，下锅加生抽、白糖炒香。","image":""},{"text":"肉片用老抽、蚝油、白糖拌匀，皮朝下码入碗底，铺上梅干菜压实。","image":""},{"text":"大火蒸 1.5 小时，倒扣入盘，汤汁勾芡浇上即可。","image":""}],"categoryId":"meat","createdAt":1793946000000,"updatedAt":1793946000000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"京酱肉丝","intro":"老北京风味，肉丝裹浓甜面酱，配豆腐皮和葱丝卷着吃。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/jingjiang-rousi.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/jingjiang-rousi.jpg"],"ingredients":[{"name":"猪里脊","amount":"300g"},{"name":"甜面酱","amount":"3 勺"},{"name":"豆腐皮","amount":"3 张"},{"name":"大葱","amount":"2 根"},{"name":"料酒","amount":"1 勺"},{"name":"蛋清","amount":"半个"},{"name":"淀粉","amount":"1 勺"},{"name":"白糖","amount":"1 勺"}],"steps":[{"text":"里脊切细丝，加料酒、蛋清、淀粉抓匀腌 15 分钟。","image":""},{"text":"大葱取葱白切细丝，泡水去辣；豆腐皮切方块焯水软化。","image":""},{"text":"热锅宽油下肉丝滑散，炒至变白盛出。","image":""},{"text":"锅留底油，小火下甜面酱、白糖炒出香味冒小泡。","image":""},{"text":"倒回肉丝快速翻裹酱汁，装盘配葱丝、豆腐皮卷食。","image":""}],"categoryId":"meat","createdAt":1793942400000,"updatedAt":1793942400000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"清蒸鲈鱼","intro":"最显鱼鲜的做法，8 分钟蒸出嫩滑鱼肉，豉油和热油缺一不可。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/qingzheng-luyu.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/qingzheng-luyu.jpg"],"ingredients":[{"name":"鲜鲈鱼","amount":"1 条（约 600g）"},{"name":"生姜","amount":"1 块"},{"name":"小葱","amount":"4 根"},{"name":"蒸鱼豉油","amount":"3 勺"},{"name":"料酒","amount":"1 勺"},{"name":"食用油","amount":"2 勺"}],"steps":[{"text":"鲈鱼洗净，两面各划一刀，用料酒抹匀腌 5 分钟。","image":""},{"text":"盘底垫葱段姜片，鱼身上也铺姜丝，水开后大火蒸 8 分钟。","image":""},{"text":"蒸好后倒掉盘中汁水，去掉旧葱姜。","image":""},{"text":"鱼身铺新葱丝、姜丝，淋上蒸鱼豉油。","image":""},{"text":"烧一勺热油到冒烟，浇在葱丝上激出香味即可。","image":""}],"categoryId":"seafood","createdAt":1793938800000,"updatedAt":1793938800000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"油焖大虾","intro":"鲁菜经典，大虾焖出红亮虾油，咸甜浓香，壳都值得吮一吮。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/youmen-daxia.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/youmen-daxia.jpg"],"ingredients":[{"name":"鲜大虾","amount":"500g"},{"name":"大葱","amount":"1 段"},{"name":"生姜","amount":"4 片"},{"name":"番茄酱","amount":"1 勺"},{"name":"白糖","amount":"1 勺"},{"name":"料酒","amount":"1 勺"},{"name":"盐","amount":"适量"}],"steps":[{"text":"大虾剪去虾须虾枪，开背挑去虾线，擦干水分。","image":""},{"text":"热锅多放油，中小火把虾煎至变红，用铲子轻压虾头煎出虾油。","image":""},{"text":"下葱段、姜片爆香，加料酒、番茄酱、白糖和小半碗热水。","image":""},{"text":"盖盖中小火焖 3 分钟，加盐调味。","image":""},{"text":"大火收汁至浓稠裹虾，出锅摆盘浇汁。","image":""}],"categoryId":"seafood","createdAt":1793935200000,"updatedAt":1793935200000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"蒜蓉粉丝蒸扇贝","intro":"夜市人气王，粉丝吸满蒜香汤汁，扇贝鲜甜弹嫩。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/suannrong-fensi-shanbei.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/suannrong-fensi-shanbei.jpg"],"ingredients":[{"name":"扇贝","amount":"6 个"},{"name":"龙口粉丝","amount":"1 把"},{"name":"大蒜","amount":"1 整头"},{"name":"小米辣","amount":"2 个"},{"name":"蒸鱼豉油","amount":"2 勺"},{"name":"小葱","amount":"2 根"},{"name":"食用油","amount":"3 勺"}],"steps":[{"text":"粉丝温水泡软剪段；大蒜剁成蒜蓉，一半下油锅小火炸至金黄，关火拌入另一半生蒜蓉，加蒸鱼豉油做成金银蒜酱。","image":""},{"text":"扇贝刷净撬开，取半壳摆盘，壳上铺粉丝。","image":""},{"text":"把金银蒜酱铺在粉丝上，撒小米辣圈。","image":""},{"text":"水开后大火蒸 5 分钟取出。","image":""},{"text":"撒葱花，浇一勺热油激香即可。","image":""}],"categoryId":"seafood","createdAt":1793931600000,"updatedAt":1793931600000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"剁椒鱼头","intro":"湘菜头牌，红艳艳的剁椒盖满鱼头，鲜辣开胃，汤汁拌面更是一绝。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/duojiao-yutou.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/duojiao-yutou.jpg"],"ingredients":[{"name":"胖头鱼鱼头","amount":"1 个（约 800g）"},{"name":"剁椒","amount":"150g"},{"name":"生姜","amount":"1 块"},{"name":"大蒜","amount":"5 瓣"},{"name":"蒸鱼豉油","amount":"2 勺"},{"name":"啤酒","amount":"半罐"},{"name":"小葱","amount":"3 根"}],"steps":[{"text":"鱼头从中间劈开不切断，洗净黑膜，用料酒和姜片腌 10 分钟。","image":""},{"text":"盘底垫姜片葱段，鱼头剖面向上摆开，倒入少许啤酒去腥。","image":""},{"text":"剁椒、姜末、蒜末拌匀，厚厚铺满鱼头。","image":""},{"text":"水开后大火蒸 12 分钟，淋蒸鱼豉油。","image":""},{"text":"撒葱花，浇热油激香，配一碗煮好的面条拌汤汁吃。","image":""}],"categoryId":"seafood","createdAt":1793928000000,"updatedAt":1793928000000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"红烧带鱼","intro":"家常下饭鱼，带鱼煎香再红烧，咸鲜微甜，肉质细嫩不腥。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/hongshao-daiyu.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/hongshao-daiyu.jpg"],"ingredients":[{"name":"带鱼","amount":"500g"},{"name":"生姜","amount":"5 片"},{"name":"大蒜","amount":"4 瓣"},{"name":"生抽","amount":"2 勺"},{"name":"老抽","amount":"半勺"},{"name":"香醋","amount":"1 勺"},{"name":"白糖","amount":"1 勺"},{"name":"料酒","amount":"2 勺"},{"name":"面粉","amount":"适量"}],"steps":[{"text":"带鱼去头尾、去内脏黑膜，切段擦干，两面薄拍一层面粉。","image":""},{"text":"热锅宽油，把带鱼煎至两面金黄定型，盛出。","image":""},{"text":"锅留底油，爆香姜片、蒜瓣。","image":""},{"text":"放入带鱼，加料酒、生抽、老抽、香醋、白糖和一碗热水。","image":""},{"text":"中小火烧 8 分钟入味，大火收汁，轻轻晃锅不要翻动鱼身。","image":""}],"categoryId":"seafood","createdAt":1793924400000,"updatedAt":1793924400000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"蛤蜊蒸蛋","intro":"羹嫩如布丁、蛤蜊鲜掉眉毛，一碗端上桌就是海的鲜味。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/geli-zhengdan.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/geli-zhengdan.jpg"],"ingredients":[{"name":"蛤蜊","amount":"300g"},{"name":"鸡蛋","amount":"3 个"},{"name":"温水","amount":"300ml"},{"name":"蒸鱼豉油","amount":"1 勺"},{"name":"小葱","amount":"1 根"},{"name":"料酒","amount":"1 勺"},{"name":"香油","amount":"几滴"}],"steps":[{"text":"蛤蜊吐沙洗净，冷水下锅加料酒煮至开口，捞出，煮蛤蜊的水滤出留用。","image":""},{"text":"鸡蛋打散，加等量温蛤蜊水（晾凉）搅匀，过筛倒入深盘。","image":""},{"text":"蛤蜊带壳插入蛋液中。","image":""},{"text":"盖保鲜膜扎孔，水开后中火蒸 10 分钟至蛋液凝固。","image":""},{"text":"淋蒸鱼豉油、香油，撒葱花即可。","image":""}],"categoryId":"seafood","createdAt":1793920800000,"updatedAt":1793920800000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"葱爆鱿鱼","intro":"大火快炒的镬气菜，鱿鱼脆弹、葱香扑鼻，一盘不够分。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/congbao-youyu.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/congbao-youyu.jpg"],"ingredients":[{"name":"鲜鱿鱼","amount":"2 条"},{"name":"大葱","amount":"2 根"},{"name":"生姜","amount":"4 片"},{"name":"生抽","amount":"1 勺"},{"name":"蚝油","amount":"1 勺"},{"name":"料酒","amount":"1 勺"},{"name":"盐","amount":"适量"}],"steps":[{"text":"鱿鱼撕去外膜，切花刀再改小块；大葱斜切滚刀段。","image":""},{"text":"鱿鱼块冷水下锅，加料酒焯烫 15 秒卷起立刻捞出。","image":""},{"text":"热锅多放油，大火爆香姜片，下葱段炒香。","image":""},{"text":"倒入鱿鱼卷，加生抽、蚝油，大火爆炒 30 秒。","image":""},{"text":"加盐调匀即可出锅，全程大火保持脆嫩。","image":""}],"categoryId":"seafood","createdAt":1793917200000,"updatedAt":1793917200000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"香菇油菜","intro":"素菜里的颜值担当，油菜翠绿、香菇饱满，勾一层薄汁鲜香滑口。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/xianggu-youcai.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/xianggu-youcai.jpg"],"ingredients":[{"name":"上海青","amount":"400g"},{"name":"鲜香菇","amount":"8 朵"},{"name":"大蒜","amount":"3 瓣"},{"name":"蚝油","amount":"1 勺"},{"name":"生抽","amount":"1 勺"},{"name":"淀粉","amount":"半勺"},{"name":"盐","amount":"适量"}],"steps":[{"text":"油菜洗净对半切开，香菇切十字花刀。","image":""},{"text":"水开加少许盐和油，油菜焯 30 秒捞出摆盘。","image":""},{"text":"香菇下锅煮 2 分钟捞出。","image":""},{"text":"热锅爆香蒜末，放香菇，加蚝油、生抽和小半碗水烧 2 分钟。","image":""},{"text":"淋水淀粉勾薄芡，把香菇连汁浇在油菜上。","image":""}],"categoryId":"veggie","createdAt":1793913600000,"updatedAt":1793913600000}]