[{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"蚝油生菜","intro":"五分钟搞定的快手素菜，生菜脆嫩清甜，蚝油汁咸鲜适口。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/haoyou-shengcai.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/haoyou-shengcai.jpg"],"ingredients":[{"name":"生菜","amount":"500g"},{"name":"大蒜","amount":"4 瓣"},{"name":"蚝油","amount":"2 勺"},{"name":"生抽","amount":"1 勺"},{"name":"白糖","amount":"半勺"},{"name":"淀粉","amount":"半勺"}],"steps":[{"text":"生菜洗净撕大朵，大蒜切末。","image":""},{"text":"水烧开加少许盐和几滴油，生菜下锅烫 15 秒立刻捞出，摆盘沥去水分。","image":""},{"text":"用蚝油、生抽、白糖、淀粉加半碗水调成碗汁。","image":""},{"text":"热锅少油爆香蒜末，倒入碗汁小火煮至浓稠透亮。","image":""},{"text":"把蒜蓉蚝油汁浇在生菜上即可。","image":""}],"categoryId":"veggie","createdAt":1793910000000,"updatedAt":1793910000000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"手撕包菜","intro":"手撕的断面更挂味，大火干炒至边缘微焦，醋香脆嫩。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/shousi-baocai.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/shousi-baocai.jpg"],"ingredients":[{"name":"包菜","amount":"半个（约 500g）"},{"name":"干辣椒","amount":"5 个"},{"name":"大蒜","amount":"3 瓣"},{"name":"花椒","amount":"10 粒"},{"name":"香醋","amount":"1 勺"},{"name":"生抽","amount":"1 勺"},{"name":"盐","amount":"适量"}],"steps":[{"text":"包菜用手撕成大块，洗净后彻底沥干水分。","image":""},{"text":"热锅倒油，小火煸香花椒后捞出，下干辣椒段、蒜片爆香。","image":""},{"text":"转大火下包菜，快速翻炒 1 分钟至边缘微微焦边。","image":""},{"text":"加生抽、盐调味，沿锅边淋香醋。","image":""},{"text":"再翻炒 20 秒立刻出锅，保持脆感。","image":""}],"categoryId":"veggie","createdAt":1793906400000,"updatedAt":1793906400000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"凉拌黄瓜","intro":"拍黄瓜是夏天的灵魂，酸辣蒜香，爽脆解腻，几分钟上桌。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/liangban-huanggua.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/liangban-huanggua.jpg"],"ingredients":[{"name":"黄瓜","amount":"2 根"},{"name":"大蒜","amount":"4 瓣"},{"name":"香醋","amount":"2 勺"},{"name":"生抽","amount":"1 勺"},{"name":"香油","amount":"1 勺"},{"name":"白糖","amount":"半勺"},{"name":"小米辣","amount":"1 个"}],"steps":[{"text":"黄瓜洗净，用刀背拍裂，再切小段。","image":""},{"text":"加半勺盐拌匀，腌 5 分钟后倒掉渗出的水分。","image":""},{"text":"蒜切末、小米辣切圈，加香醋、生抽、白糖、香油调成料汁。","image":""},{"text":"料汁浇在黄瓜上拌匀。","image":""},{"text":"装盘后可撒少许熟花生碎，冷藏 10 分钟更爽口。","image":""}],"categoryId":"veggie","createdAt":1793902800000,"updatedAt":1793902800000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"家常豆腐","intro":"老豆腐煎出金黄外壳再烧入味，外韧里嫩，微辣带甜。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/jiachang-doufu.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/jiachang-doufu.jpg"],"ingredients":[{"name":"老豆腐","amount":"400g"},{"name":"青椒","amount":"1 个"},{"name":"胡萝卜","amount":"半根"},{"name":"木耳","amount":"几朵"},{"name":"郫县豆瓣酱","amount":"1 勺"},{"name":"生抽","amount":"1 勺"},{"name":"白糖","amount":"半勺"},{"name":"蒜","amount":"2 瓣"}],"steps":[{"text":"老豆腐切三角形厚片，青椒、胡萝卜切片，木耳泡发。","image":""},{"text":"平底锅多放油，豆腐片煎至两面金黄盛出。","image":""},{"text":"锅留底油，下豆瓣酱、蒜末小火炒出红油。","image":""},{"text":"加青椒、胡萝卜、木耳炒断生，倒回豆腐。","image":""},{"text":"加生抽、白糖和小半碗水，中火烧 2 分钟收汁即可。","image":""}],"categoryId":"veggie","createdAt":1793899200000,"updatedAt":1793899200000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"凉拌木耳","intro":"酸辣爽脆的凉拌小菜，木耳弹嫩，开胃解腻，宴客也拿得出手。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/liangban-muer.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/liangban-muer.jpg"],"ingredients":[{"name":"干木耳","amount":"1 把"},{"name":"小米辣","amount":"2 个"},{"name":"香菜","amount":"2 根"},{"name":"大蒜","amount":"3 瓣"},{"name":"香醋","amount":"2 勺"},{"name":"生抽","amount":"1 勺"},{"name":"香油","amount":"1 勺"},{"name":"白糖","amount":"半勺"}],"steps":[{"text":"木耳冷水泡发 2 小时，撕成小朵洗净。","image":""},{"text":"水开后木耳焯煮 3 分钟，捞出过凉水，彻底沥干。","image":""},{"text":"蒜切末、小米辣切圈、香菜切段。","image":""},{"text":"用香醋、生抽、白糖、香油和少许盐调成酸辣汁。","image":""},{"text":"所有材料拌匀，腌 5 分钟入味即可。","image":""}],"categoryId":"veggie","createdAt":1793895600000,"updatedAt":1793895600000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"上汤娃娃菜","intro":"娃娃菜泡在鲜汤里，清甜软嫩，皮蛋和蒜瓣让汤底鲜味翻倍。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/shangtang-wawacai.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/shangtang-wawacai.jpg"],"ingredients":[{"name":"娃娃菜","amount":"3 棵"},{"name":"皮蛋","amount":"1 个"},{"name":"大蒜","amount":"6 瓣"},{"name":"火腿丁","amount":"30g"},{"name":"高汤或浓汤宝","amount":"500ml"},{"name":"盐","amount":"适量"}],"steps":[{"text":"娃娃菜洗净切长条，皮蛋切丁，蒜瓣炸至金黄备用。","image":""},{"text":"锅中倒入高汤煮开，下蒜瓣、火腿丁煮 2 分钟。","image":""},{"text":"下娃娃菜煮 2 分钟至叶片变软。","image":""},{"text":"加入皮蛋丁，小火再煮 1 分钟。","image":""},{"text":"加盐调味，连汤带菜装碗上桌。","image":""}],"categoryId":"veggie","createdAt":1793892000000,"updatedAt":1793892000000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"虎皮青椒","intro":"青椒干煸出焦香虎皮纹，吸饱酸甜酱汁，是素菜里的下饭狠角色。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/hupi-qingjiao.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/hupi-qingjiao.jpg"],"ingredients":[{"name":"薄皮青椒","amount":"6 个"},{"name":"大蒜","amount":"3 瓣"},{"name":"生抽","amount":"2 勺"},{"name":"香醋","amount":"1 勺"},{"name":"白糖","amount":"1 勺"},{"name":"盐","amount":"适量"}],"steps":[{"text":"青椒去蒂去籽，用刀面轻压扁，擦干水分。","image":""},{"text":"干锅不放油，中小火把青椒两面煸出焦斑虎皮纹，盛出。","image":""},{"text":"热锅倒油，爆香蒜末。","image":""},{"text":"用生抽、香醋、白糖、盐加 2 勺水调成酱汁倒入锅中。","image":""},{"text":"放入青椒小火烧 1 分钟，让虎皮吸饱酱汁，收汁装盘。","image":""}],"categoryId":"veggie","createdAt":1793888400000,"updatedAt":1793888400000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"素炒三丝","intro":"土豆丝、胡萝卜丝、青椒丝三色同炒，清脆爽口，色彩诱人。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/suchao-sansi.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/suchao-sansi.jpg"],"ingredients":[{"name":"土豆","amount":"1 个"},{"name":"胡萝卜","amount":"1 根"},{"name":"青椒","amount":"1 个"},{"name":"大蒜","amount":"2 瓣"},{"name":"白醋","amount":"1 勺"},{"name":"盐","amount":"适量"},{"name":"食用油","amount":"适量"}],"steps":[{"text":"土豆、胡萝卜去皮切丝，土豆丝泡水去淀粉；青椒切丝。","image":""},{"text":"热锅倒油，爆香蒜片。","image":""},{"text":"先下胡萝卜丝炒 1 分钟，再下土豆丝大火翻炒 1 分钟。","image":""},{"text":"加青椒丝，加盐调味，沿锅边淋白醋。","image":""},{"text":"大火翻炒 30 秒断生即出锅，保持脆嫩。","image":""}],"categoryId":"veggie","createdAt":1793884800000,"updatedAt":1793884800000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"番茄蛋花汤","intro":"最经典的快手汤，番茄炒出沙再冲汤，蛋花如絮，酸甜暖胃。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/fanqie-danhua-tang.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/fanqie-danhua-tang.jpg"],"ingredients":[{"name":"番茄","amount":"2 个"},{"name":"鸡蛋","amount":"2 个"},{"name":"小葱","amount":"1 根"},{"name":"番茄酱","amount":"半勺"},{"name":"香油","amount":"几滴"},{"name":"盐","amount":"适量"},{"name":"水淀粉","amount":"少许"}],"steps":[{"text":"番茄去皮切小块，鸡蛋打散。","image":""},{"text":"热锅少油，下番茄块小火炒出沙，加半勺番茄酱炒匀。","image":""},{"text":"倒入两碗热水，大火烧开煮 2 分钟。","image":""},{"text":"淋少许水淀粉让汤略稠，转小火，画圈淋入蛋液，凝成蛋絮再推散。","image":""},{"text":"加盐调味，撒葱花、滴香油出锅。","image":""}],"categoryId":"soup","createdAt":1793881200000,"updatedAt":1793881200000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"冬瓜排骨汤","intro":"清润不油腻的广式靓汤，排骨炖到酥烂，冬瓜入口即化。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/donggua-paigu-tang.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/donggua-paigu-tang.jpg"],"ingredients":[{"name":"猪排骨","amount":"400g"},{"name":"冬瓜","amount":"500g"},{"name":"生姜","amount":"4 片"},{"name":"料酒","amount":"1 勺"},{"name":"枸杞","amount":"一小把"},{"name":"盐","amount":"适量"},{"name":"白胡椒粉","amount":"少许"}],"steps":[{"text":"排骨冷水下锅加料酒焯水，捞出冲净浮沫。","image":""},{"text":"砂锅加足量热水，放排骨、姜片，大火烧开转小火炖 40 分钟。","image":""},{"text":"冬瓜去皮切大块放入锅中。","image":""},{"text":"继续炖 15 分钟至冬瓜透明软烂，加枸杞再煮 5 分钟。","image":""},{"text":"加盐、少许白胡椒粉调味即成。","image":""}],"categoryId":"soup","createdAt":1793877600000,"updatedAt":1793877600000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"山药乌鸡汤","intro":"滋补养生汤，乌鸡炖出浓郁汤色，山药粉糯，适合秋冬进补。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/shanyao-wuji-tang.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/shanyao-wuji-tang.jpg"],"ingredients":[{"name":"乌鸡","amount":"半只"},{"name":"铁棍山药","amount":"300g"},{"name":"红枣","amount":"6 颗"},{"name":"枸杞","amount":"1 小把"},{"name":"生姜","amount":"5 片"},{"name":"料酒","amount":"1 勺"},{"name":"盐","amount":"适量"}],"steps":[{"text":"乌鸡剁块冷水下锅，加料酒焯水，捞出洗净。","image":""},{"text":"砂锅加足量热水，放乌鸡、姜片、红枣，烧开转小火炖 1 小时。","image":""},{"text":"山药戴手套削皮切段，泡在清水里防氧化。","image":""},{"text":"山药入锅续炖 20 分钟至粉糯。","image":""},{"text":"加枸杞、盐调味，再煮 5 分钟即可。","image":""}],"categoryId":"soup","createdAt":1793874000000,"updatedAt":1793874000000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"酸辣汤","intro":"河南风味酸辣汤，胡椒的辣、醋的酸配合丝滑汤体，一碗下去浑身舒坦。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/suanla-tang.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/suanla-tang.jpg"],"ingredients":[{"name":"豆腐","amount":"100g"},{"name":"木耳","amount":"几朵"},{"name":"胡萝卜","amount":"半根"},{"name":"鸡蛋","amount":"1 个"},{"name":"香菇","amount":"2 朵"},{"name":"白胡椒粉","amount":"1 小勺"},{"name":"香醋","amount":"3 勺"},{"name":"水淀粉","amount":"适量"},{"name":"香油","amount":"几滴"}],"steps":[{"text":"豆腐、泡发木耳、胡萝卜、香菇全部切细丝。","image":""},{"text":"锅中水开，先下胡萝卜丝、木耳丝、香菇丝煮 2 分钟。","image":""},{"text":"下豆腐丝，加盐、大量白胡椒粉调味。","image":""},{"text":"淋水淀粉把汤调到略稠，转小火淋入蛋液成蛋花。","image":""},{"text":"关火前沿锅边淋入香醋，搅匀后滴香油，撒葱花出锅。","image":""}],"categoryId":"soup","createdAt":1793870400000,"updatedAt":1793870400000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"银耳莲子羹","intro":"润燥养颜的甜汤，小火慢炖到胶质浓稠，睡前一碗很熨帖。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/yiner-lianzi-geng.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/yiner-lianzi-geng.jpg"],"ingredients":[{"name":"干银耳","amount":"半朵"},{"name":"莲子","amount":"50g"},{"name":"红枣","amount":"6 颗"},{"name":"枸杞","amount":"1 小把"},{"name":"冰糖","amount":"30g"}],"steps":[{"text":"银耳冷水泡发 2 小时，去黄蒂撕成小朵；莲子、红枣洗净。","image":""},{"text":"银耳加水大火煮开，转小火炖 40 分钟，期间多搅动几次帮助出胶。","image":""},{"text":"加入莲子、红枣继续炖 30 分钟。","image":""},{"text":"汤色转浓稠后加冰糖、枸杞。","image":""},{"text":"再炖 10 分钟关火，焖 5 分钟口感更佳。","image":""}],"categoryId":"soup","createdAt":1793866800000,"updatedAt":1793866800000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"海带豆腐汤","intro":"低脂鲜美的快手汤，海带的咸鲜配上嫩豆腐，简单却很鲜。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/haidai-doufu-tang.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/haidai-doufu-tang.jpg"],"ingredients":[{"name":"干海带结","amount":"100g"},{"name":"嫩豆腐","amount":"300g"},{"name":"姜","amount":"3 片"},{"name":"虾皮","amount":"1 小把"},{"name":"盐","amount":"适量"},{"name":"香油","amount":"几滴"}],"steps":[{"text":"海带结提前泡发 1 小时，冲洗干净。","image":""},{"text":"锅中加水烧开，下海带结、姜片煮 10 分钟。","image":""},{"text":"豆腐切块放入，加虾皮同煮 5 分钟。","image":""},{"text":"加盐调味。","image":""},{"text":"关火滴香油，撒葱花即可。","image":""}],"categoryId":"soup","createdAt":1793863200000,"updatedAt":1793863200000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"蛋炒饭","intro":"检验厨房功力的基本功，粒粒分明、蛋液金黄，隔夜饭才是正解。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/dan-chao-fan.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/dan-chao-fan.jpg"],"ingredients":[{"name":"隔夜米饭","amount":"2 碗"},{"name":"鸡蛋","amount":"2 个"},{"name":"火腿丁","amount":"50g"},{"name":"葱花","amount":"2 根的量"},{"name":"盐","amount":"适量"},{"name":"白胡椒粉","amount":"少许"}],"steps":[{"text":"隔夜饭提前用手抓散，不留饭团。","image":""},{"text":"热锅多放油，倒入打散的蛋液，趁未凝固立刻倒入米饭。","image":""},{"text":"大火快速翻炒，让每粒米都裹上蛋液（金包银）。","image":""},{"text":"加火腿丁翻炒，用锅铲压散结块的米饭，炒至米粒在锅里跳。","image":""},{"text":"加盐、白胡椒粉调味，撒葱花翻两下出锅。","image":""}],"categoryId":"staple","createdAt":1793859600000,"updatedAt":1793859600000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"猪肉白菜水饺","intro":"北方年味担当，白菜翠嫩多汁，肉馅打水上劲，蘸醋蒜更香。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/zhurou-baicai-shuijiao.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/zhurou-baicai-shuijiao.jpg"],"ingredients":[{"name":"面粉","amount":"500g"},{"name":"猪前腿肉馅","amount":"300g"},{"name":"大白菜","amount":"400g"},{"name":"大葱","amount":"1 根"},{"name":"姜末","amount":"1 勺"},{"name":"生抽","amount":"2 勺"},{"name":"香油","amount":"1 勺"},{"name":"盐","amount":"适量"}],"steps":[{"text":"面粉加温水和成偏软面团，醒 30 分钟。","image":""},{"text":"肉馅加姜末、生抽、盐，分三次打入 3 勺葱姜水，顺一个方向搅上劲。","image":""},{"text":"白菜切碎撒盐杀水 10 分钟，挤干后与葱花一起拌入肉馅，淋香油封味。","image":""},{"text":"面团搓条切剂擀皮，包入馅料捏紧。","image":""},{"text":"水开下饺子，点两次凉水，煮至浮起鼓胀捞出，配醋蒜蘸食。","image":""}],"categoryId":"staple","createdAt":1793856000000,"updatedAt":1793856000000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"皮蛋瘦肉粥","intro":"广式经典粥品，米粒开花绵滑，皮蛋的溏心咸香融进每一口。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/pidan-shourou-zhou.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/pidan-shourou-zhou.jpg"],"ingredients":[{"name":"大米","amount":"100g"},{"name":"皮蛋","amount":"2 个"},{"name":"猪里脊","amount":"100g"},{"name":"生姜","amount":"3 片"},{"name":"小葱","amount":"1 根"},{"name":"料酒","amount":"半勺"},{"name":"盐","amount":"适量"},{"name":"香油","amount":"几滴"}],"steps":[{"text":"大米洗净加少许盐和油腌 15 分钟；里脊切细丝，用料酒、姜丝腌 10 分钟。","image":""},{"text":"一个皮蛋切丁与米同煮，水开转小火熬 30 分钟至米粒开花。","image":""},{"text":"肉丝拌开下锅，煮 3 分钟至变色。","image":""},{"text":"另一个皮蛋切丁加入，再煮 5 分钟。","image":""},{"text":"加盐调味，撒葱花，滴几滴香油。","image":""}],"categoryId":"staple","createdAt":1793852400000,"updatedAt":1793852400000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"红烧牛肉面","intro":"汤浓肉烂的红烧牛肉面，牛肉炖到筷子一夹就散，连汤都要喝干净。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/hongshao-niurou-mian.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/hongshao-niurou-mian.jpg"],"ingredients":[{"name":"牛腩","amount":"500g"},{"name":"面条","amount":"4 份"},{"name":"郫县豆瓣酱","amount":"2 勺"},{"name":"番茄","amount":"1 个"},{"name":"八角","amount":"2 颗"},{"name":"桂皮","amount":"1 段"},{"name":"生抽","amount":"2 勺"},{"name":"老抽","amount":"1 勺"},{"name":"青菜","amount":"4 棵"},{"name":"姜片","amount":"5 片"}],"steps":[{"text":"牛腩切块冷水下锅焯水，捞出洗净。","image":""},{"text":"热锅炒化豆瓣酱出红油，下牛腩、姜片、八角、桂皮翻炒，加生抽、老抽。","image":""},{"text":"加热水没过牛肉，大火烧开转小火炖 1.5 小时；中途可加去皮番茄块同炖增香。","image":""},{"text":"另起锅煮面，烫青菜；碗中可先焯面的汤打底。","image":""},{"text":"面条装碗，浇上牛肉和浓汤，摆上青菜即成。","image":""}],"categoryId":"staple","createdAt":1793848800000,"updatedAt":1793848800000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"三鲜馄饨","intro":"皮薄如纱的馄饨，鲜肉虾仁蛋皮三鲜合一，汤底撒虾皮紫菜最提味。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/sanxian-huntun.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/sanxian-huntun.jpg"],"ingredients":[{"name":"馄饨皮","amount":"300g"},{"name":"猪肉馅","amount":"200g"},{"name":"虾仁","amount":"100g"},{"name":"鸡蛋","amount":"2 个"},{"name":"紫菜","amount":"适量"},{"name":"虾皮","amount":"1 小把"},{"name":"生抽","amount":"1 勺"},{"name":"香油","amount":"1 勺"},{"name":"小葱","amount":"2 根"}],"steps":[{"text":"虾仁切粒与肉馅混合，加生抽、盐、葱花顺一个方向搅上劲。","image":""},{"text":"鸡蛋摊成薄蛋皮，切丝备用。","image":""},{"text":"馄饨皮包入馅料，虎口一收捏成元宝状。","image":""},{"text":"碗中放紫菜、虾皮、生抽、香油，冲入开水或煮开的骨汤。","image":""},{"text":"馄饨下锅煮至浮起再煮 1 分钟，捞入汤碗，铺蛋皮丝撒葱花。","image":""}],"categoryId":"staple","createdAt":1793845200000,"updatedAt":1793845200000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"葱油饼","intro":"外层酥脆起层、内里柔软葱香，趁热撕着吃最过瘾。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/congyou-bing.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/congyou-bing.jpg"],"ingredients":[{"name":"面粉","amount":"300g"},{"name":"温水","amount":"200ml"},{"name":"小葱","amount":"1 大把"},{"name":"食用油","amount":"3 勺"},{"name":"盐","amount":"1 小勺"},{"name":"花椒面","amount":"少许"}],"steps":[{"text":"面粉加温水和成软面团，盖湿布醒 30 分钟。","image":""},{"text":"小葱切碎，热油泼香做成葱油，加盐和花椒面拌匀。","image":""},{"text":"面团分成 4 份，擀成薄片，抹葱油后卷起再盘成螺旋状。","image":""},{"text":"把剂子按扁擀开，尽量薄，能透出葱影为佳。","image":""},{"text":"平底锅多放油，中小火烙至两面金黄起酥层，出锅切块。","image":""}],"categoryId":"staple","createdAt":1793841600000,"updatedAt":1793841600000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"双皮奶","intro":"顺德名甜品，奶皮两层叠加，入口滑嫩如脂，奶香纯粹。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/shuangpi-nai.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/shuangpi-nai.jpg"],"ingredients":[{"name":"全脂牛奶","amount":"400ml"},{"name":"蛋清","amount":"2 个"},{"name":"白糖","amount":"25g"},{"name":"红豆","amount":"适量"}],"steps":[{"text":"牛奶小火加热到锅边冒小泡，倒入碗中放凉，表面结出第一层奶皮。","image":""},{"text":"蛋清加白糖打散，不要打出太多泡。","image":""},{"text":"碗边小口倒出牛奶（奶皮留在碗底），牛奶与蛋清混合过筛。","image":""},{"text":"混合液沿碗边缓缓倒回，让第一层奶皮浮起。","image":""},{"text":"盖保鲜膜水开后中小火蒸 12 分钟，焖 5 分钟，放凉后撒蜜红豆。","image":""}],"categoryId":"dessert","createdAt":1793838000000,"updatedAt":1793838000000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"芒果西米露","intro":"港式糖水经典，西米 Q 弹透亮，芒果香甜多汁，椰浆一加就封神。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/mangguo-ximilu.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/mangguo-ximilu.jpg"],"ingredients":[{"name":"西米","amount":"80g"},{"name":"芒果","amount":"2 个"},{"name":"椰浆","amount":"200ml"},{"name":"牛奶","amount":"100ml"},{"name":"白糖","amount":"20g"}],"steps":[{"text":"水大开后下西米，中火煮 15 分钟，中间不停搅动防粘底。","image":""},{"text":"煮至只剩小白芯时关火，盖盖焖 5 分钟至完全透明。","image":""},{"text":"西米过凉开水冲去黏质，沥干备用。","image":""},{"text":"芒果一半切丁，一半加椰浆、牛奶、白糖打成浓浆。","image":""},{"text":"杯中放西米、芒果浆拌匀，面上铺芒果丁，冷藏后更好吃。","image":""}],"categoryId":"dessert","createdAt":1793834400000,"updatedAt":1793834400000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"桂花糯米藕","intro":"江南秋日限定，糯米灌进藕孔慢煮，红糖桂花蜜色红亮，切一片能拉出糖丝。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/guihua-nuomi-ou.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/guihua-nuomi-ou.jpg"],"ingredients":[{"name":"七孔莲藕","amount":"2 节"},{"name":"糯米","amount":"200g"},{"name":"红糖","amount":"100g"},{"name":"冰糖","amount":"50g"},{"name":"干桂花","amount":"1 小把"},{"name":"红枣","amount":"5 颗"}],"steps":[{"text":"糯米洗净泡 2 小时沥干；莲藕去皮，一端切下 2 厘米做盖。","image":""},{"text":"把糯米一点点灌进藕孔，用筷子捅实，盖上藕盖用牙签固定。","image":""},{"text":"锅中加水没过藕，放红糖、冰糖、红枣，大火烧开。","image":""},{"text":"转小火盖盖煮 1.5 小时，至汤汁浓稠、藕色红亮。","image":""},{"text":"晾凉切片，淋糖汁撒干桂花。","image":""}],"categoryId":"dessert","createdAt":1793830800000,"updatedAt":1793830800000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"冰糖雪梨","intro":"秋冬润喉小甜汤，雪梨炖出清甜汁水，加枸杞红枣更温润。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/bingtang-xueli.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/bingtang-xueli.jpg"],"ingredients":[{"name":"雪梨","amount":"2 个"},{"name":"冰糖","amount":"30g"},{"name":"枸杞","amount":"1 小把"},{"name":"红枣","amount":"4 颗"}],"steps":[{"text":"雪梨洗净去皮，去核切成大块（带皮炖润肺效果更好，可不去皮）。","image":""},{"text":"炖盅或汤锅放雪梨、冰糖、红枣，加没过食材的水。","image":""},{"text":"大火烧开后转小火炖 30 分钟。","image":""},{"text":"加枸杞再炖 5 分钟。","image":""},{"text":"吃梨喝汤，趁热或放凉都好。","image":""}],"categoryId":"dessert","createdAt":1793827200000,"updatedAt":1793827200000},{"authorOpenid":"","authorNickname":"小杜里精选","authorAvatar":"","name":"南瓜饼","intro":"金黄软糯的暖心小点心，南瓜的清甜裹着白芝麻香，趁热吃会拉丝。","cover":"cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/nangua-bing.jpg","images":["cloud://cloud1-d5ga1hj0qb4d21f6a.636c-cloud1-d5ga1hj0qb4d21f6a-1325529878/recipes/seed/nangua-bing.jpg"],"ingredients":[{"name":"老南瓜","amount":"300g"},{"name":"糯米粉","amount":"250g"},{"name":"白糖","amount":"30g"},{"name":"白芝麻","amount":"适量"},{"name":"红豆沙","amount":"150g"},{"name":"食用油","amount":"适量"}],"steps":[{"text":"南瓜去皮切片，大火蒸 15 分钟至软烂，趁热压成泥。","image":""},{"text":"南瓜泥加白糖、糯米粉揉成光滑不粘手的面团。","image":""},{"text":"面团分成小剂，包入红豆沙搓圆压扁，两面沾白芝麻。","image":""},{"text":"平底锅放少许油，小火把饼煎至两面金黄鼓起。","image":""},{"text":"出锅稍晾，外脆里糯趁热吃。","image":""}],"categoryId":"dessert","createdAt":1793823600000,"updatedAt":1793823600000}]