page {
  --bg: #fff8f0;
  --card: #ffffff;
  --ink: #2f241c;
  --ink-soft: #5f4d3f;
  --muted: #9a8a7b;
  --accent: #e86a33;
  --accent-soft: #ffe7d8;
  --line: #f0e2d4;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
image,
input,
textarea,
button,
swiper,
swiper-item {
  box-sizing: border-box;
}

image {
  display: block;
}
